{
	"inputs": [
		{
			"id": "github-pat",
			"type": "promptString",
			"description": "GitHub Personal Access Token",
			"password": true
		}
	],
	"servers": 
	{
		"github": {
		"command": "npx",
		"args": [
			"-y",
			"@modelcontextprotocol/server-github"
		],
		"env": {
			"GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-pat}"
		}
		},
    "azure": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    }
	}
}