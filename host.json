{
  "version": "2.0",
  "functionTimeout": "01:10:00",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Function.pvdaq_ingest": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensions": {
    "serviceBus": {
      "clientRetryOptions": {
        "mode": "exponential",
        "tryTimeout": "00:01:00",
        "delay": "00:00:00.80",
        "maxDelay": "00:01:00",
        "maxRetries": 3
      },
      "batchOptions": {
        "maxMessageCount": 1
      },
      "maxConcurrentCalls": 1,
      "maxAutoLockRenewalDurationInMinutes": 65
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  }
}
